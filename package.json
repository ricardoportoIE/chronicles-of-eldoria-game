{
  "name": "chronicles-of-eldoria",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "node tests/browser.mjs",
    "test:performance": "npm run build && node tests/performance.mjs",
    "test:security": "vitest run tests/security.test.js && npm audit --audit-level=moderate",
    "test:quality": "npm run test:coverage && npm run test:e2e && npm run test:performance && npm run test:security && npm run build",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^5.0.1",
    "axe-core": "^4.13.0",
    "jsdom": "^30.1.0",
    "playwright-core": "^1.63.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "three": "^0.186.0"
  }
}
